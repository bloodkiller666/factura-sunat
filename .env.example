# --- Correo electrónico (envío real de comprobantes) -------------------------
# Copia este archivo a .env.local y completa los valores.

# Clave del proveedor (Resend). Sin ella, "Enviar por Correo" no envía y avisa
# que falta configurarla. Se obtiene en https://resend.com/api-keys
RESEND_API_KEY=

# Remitente que verán los clientes. Con la cuenta de pruebas de Resend solo se
# puede enviar al propio buzón usando onboarding@resend.dev.
CORREO_EMISOR="Portal TDM <onboarding@resend.dev>"

# Opcional pero recomendado en este prototipo: si la defines, TODOS los correos
# se envían a este buzón en lugar de a la dirección derivada del RUC del cliente
# (los comprobantes son datos simulados y sus buzones no existen).
# Ejemplo: CORREO_DESTINO_PRUEBA=tucorreo@gmail.com
CORREO_DESTINO_PRUEBA=
