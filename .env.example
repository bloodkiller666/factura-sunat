# Conexión al backend (FastAPI) — sin esta variable el portal no carga datos.
# En local: http://127.0.0.1:8000 · En producción: https://api.tudominio.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Proyecto de Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-CLAVE-ANON-PUBLICA

# Correo (Resend) para el envío de comprobantes por correo
RESEND_API_KEY=
CORREO_EMISOR=facturacion@tudominio.pe
# Solo para pruebas: fuerza el destino de todos los correos a una casilla tuya
CORREO_DESTINO_PRUEBA=
